{
  "expo": {
    "name": "AVA Fit",
    "slug": "ava-fit-ios",
    "version": "2.1.0",
    "orientation": "portrait",
    "scheme": "avafit",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#070A11",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.quorumprosthetics.avafit",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "AVA Fit uses Bluetooth to read pressure data from your prosthetic socket sensors.",
        "NSBluetoothPeripheralUsageDescription": "AVA Fit connects to your prosthetic socket to monitor socket fit in real time.",
        "NSHealthShareUsageDescription": "AVA Fit reads your step count to track daily activity alongside your socket wear data.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.quorumprosthetics.avafit",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#070A11"
      },
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#070A11"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3a7c9825-437d-48db-a22f-a1b38079188a"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3a7c9825-437d-48db-a22f-a1b38079188a"
    },
    "owner": "devhackr"
  }
}
